[_ylspec]
version = "0.1"
profile = "xyz.younglion.plugin"
profile_version = "1.0"

[data]
id = "xyz.younglion.ylplugin.demo"
version = "1.0.0"
publisher = "example-unverified-publisher"

[[data.entrypoints]]
id = "rcc"
runtime = "qt.rcc"
runtime_min = "1.0"
runtime_max = "1.0"
resource = "game.rcc"

[[data.entrypoints]]
id = "data"
runtime = "data"
runtime_min = "1.0"
runtime_max = "1.0"
resource = "game.rcc"

[[data.targets]]
id = "leominigames"
host = "xyz.younglion.leominigames"
api_min = "0.7"
api_max = "0.7"
entrypoint = "rcc"
required_capabilities = ["resources"]
required_permissions = []
optional_permissions = ["save"]
priority = 10

[[data.targets]]
id = "analysis"
host = "xyz.example.analysis"
api_min = "1.0"
api_max = "1.0"
entrypoint = "data"
required_permissions = { format = "bitmask", registry = "xyz.example.analysis.permissions", registry_version = "1", value = 37 }
optional_permissions = { format = "bytes", registry = "xyz.example.analysis.permissions", registry_version = "1", values = [37, 8, 255, 0] }

[[data.targets]]
id = "generic-data"
host = "*"
api_min = "1.0"
api_max = "1.0"
entrypoint = "data"
required_permissions = []
priority = -10
