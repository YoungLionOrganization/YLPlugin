@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(YLSpec 0.1.2 CONFIG)
find_dependency(nlohmann_json 3.11 CONFIG)
if("@YLPLUGIN_LIBRARY_TYPE@" STREQUAL "STATIC")
  find_dependency(OpenSSL 3.0 COMPONENTS Crypto)
  find_dependency(Threads)
  list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(ZSTD)
endif()
if(@YLPLUGIN_QT@)
  find_dependency(Qt6 6.4 COMPONENTS Core)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/YLPluginTargets.cmake")
